// Shared VERSIONINFO. Each target defines FV_FILE_DESCRIPTION, FV_INTERNAL_NAME,
// FV_ORIGINAL_FILENAME and FV_FILE_TYPE (VFT_DLL or VFT_APP) on the command line.
#include <winver.h>
#include "version.h"

#ifndef FV_FILE_TYPE
#define FV_FILE_TYPE VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EVV_VERSION_MAJOR,EVV_VERSION_MINOR,EVV_VERSION_PATCH,0
 PRODUCTVERSION EVV_VERSION_MAJOR,EVV_VERSION_MINOR,EVV_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE FV_FILE_TYPE
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenEVV SAPI5 project"
            VALUE "FileDescription", FV_FILE_DESCRIPTION
            VALUE "FileVersion", EVV_VERSION_STRING
            VALUE "InternalName", FV_INTERNAL_NAME
            VALUE "LegalCopyright", "Wrapper: GNU GPL v2. openevv engine: MIT. Language data: IBM, see NOTICE."
            VALUE "OriginalFilename", FV_ORIGINAL_FILENAME
            VALUE "ProductName", "OpenEVV SAPI5"
            VALUE "ProductVersion", EVV_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
