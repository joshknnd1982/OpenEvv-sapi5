// Names of punctuation marks and symbols, said when they are read with --punct or spelled
// (Māmaka Kaiao, and Pukui-Elbert where Māmaka Kaiao has no term).
// ’ is read as the ʻokina in words (haw_rules), so it is named ʻokina.
_.	k'i|k|o||p'au	// kiko pau, period (Māmaka Kaiao)
_,	k'i|k|o||k'o|m|a	// kiko koma, comma (MK)
_;	h'a|p|a||k|o|l'o|n|a	// hapa kolona, semicolon (MK)
_:	k|o|l'o|n|a	// kolona, colon (MK)
_?	k'i|k|o||n'i:n|au	// kiko nīnau, question mark
_!	k'i|k|o||p'u:?i|w,a	// kiko pūʻiwa, exclamation point
_"	k'a|h|a||p,u|a|n|a?'i:	// kaha puanaʻī, quotation mark (MK)
_“	k'a|h|a||p,u|a|n|a?'i:||p'a:l|u,a||v'e|h|e	// double open quote (MK)
_”	k'a|h|a||p,u|a|n|a?'i:||p'a:l|u,a||p'a|n|i	// double close quote (MK)
_„	k'a|h|a||p,u|a|n|a?'i:	// quotation mark
_’	?ok'ina	// written for the ʻokina, as the rules read it
_(	k,a|h|a'a|p|o||v'e|h|e	// kahaapo wehe, open parenthesis (MK)
_)	k,a|h|a'a|p|o||p'a|n|i	// kahaapo pani, close parenthesis (MK)
_[	k,a|h|a'a|p|o||k,i|h|i|k'i|h|i||v'e|h|e	// open bracket (MK)
_]	k,a|h|a'a|p|o||k,i|h|i|k'i|h|i||p'a|n|i	// close bracket (MK)
_{	p|a|l'e|h|ui	// palehui, brace (Pukui-Elbert)
_}	p|a|l'e|h|ui	// palehui, brace
_-	k'a|h|a||m'o|e	// kaha moe, hyphen (MK)
_‐	k'a|h|a||m'o|e	// kaha moe, hyphen
_–	k'a|h|a||m'a|h|a	// kaha maha, dash (MK)
_—	k'a|h|a||m'a|h|a	// kaha maha, dash
_…	k'i|k|o||k'o|l|u	// kiko kolu, ellipsis (MK)
_/	k'a|h|a||h|i'o:	// kaha hiō, slash (MK)
_\	k'a|h|a||h|i'o:||'i|h|o	// kaha hiō iho, backslash (MK)
__	k'a|h|a||l'a|l|o	// kaha lalo, underscore (Pukui-Elbert)
_*	k'a|h|a||k'u|h|i	// kaha kuhi, asterisk (Pukui-Elbert)
_#	k'a|h|a||k,a?a|h'u|a	// kaha kaʻahua, pound sign (MK)
_%	p'a:k'e:n|e|k,a	// pākēneka, percent (MK)
_^	k'a|h|a||h,o?o|k'o|m|o	// kaha hoʻokomo, caret (MK)
_+	k'a|h|a||h'ui	// kaha hui, plus sign (MK)
_=	k'a|h|a||l'i|k|e	// kaha like, equal sign (MK)
_<	'e|m|i||'i|h|o	// emi iho, less than (MK)
_>	n'ui||'a?e	// nui aʻe, greater than (MK)
_°	k'e:k|e|l'e:	// kēkelē, degree (MK)
_$	k'a|h|a||k'a:l'a:	// kaha kālā, dollar sign (MK)
_¢	k'a|h|a||k'e:n|e|k,a	// kaha kēneka, cent sign (MK)
_©	k,u|l|e'a|n|a||k'o|p|e	// kuleana kope, copyright (MK)

