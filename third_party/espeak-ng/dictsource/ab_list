//Hundred
_0C 	Swk_'@ 	
_0C0	Swk_'@ 	
// When more of the number follows, every part of it but the last ends in -и:
// 1977 is зқьи жәшәи хынҩажәи жәибжь, 160 шәи хынҩажәа. The forms with 0 are
// those of exact hundreds.
_1C0	Swk_'@	// шәкы
_1C	Sw'i	// шәи
_2C0	'Uw@Sw	// ҩышә
_2C	'Uw@Swi	// ҩышәи
_3C0	x'@Sw	// хышә
_3C	x'@Swi
_4C0	pSj'@Sw	// ԥшьышә
_4C	pSj'@Swi
