_5C	xw'@Swi
_6C0	f'@Sw	// фышә
_6C	f'@Swi
_7C0	b'@ZjSw@	// быжьшәы
_7C	b'@ZjSwi	// быжьшәи
_8C0	a'aSw@	// аашәы
_8C	a'aSwi	// аашәи
_9C0	ZwSw'@	// жәшәы
_9C	ZwSw'i	// жәшәи

// Thousand
// 1000 is зқьы, 2000 to 10000 and 100000 are one word each (ҩнызқь, хнызқь ...
// жәанызқь, шәнызқь); other numbers of thousands are said with нызқь after
// them (ҩажәа нызқь). The forms with x are said when no more of the number
// follows, the others end in -и (ҩнызқьи жәаха, 2013).
_1M1x	zkj'@	// зқьы
_1M1	zkj'i	// зқьи
_2M1x	Uwn'@zkj	// ҩнызқь
_2M1	Uwn'@zkji	// ҩнызқьи
_3M1x	xn'@zkj	// хнызқь
_3M1	xn'@zkji	// хнызқьи
_4M1x	pSjn'@zkj	// ԥшьнызқь
_4M1	pSjn'@zkji	// ԥшьнызқьи
_5M1x	xwn'@zkj	// хәнызқь
_5M1	xwn'@zkji	// хәнызқьи
_6M1x	fn'@zkj	// фнызқь
_6M1	fn'@zkji	// фнызқьи
_7M1x	bZjn'@zkj	// бжьнызқь
_7M1	bZjn'@zkji	// бжьнызқьи
_8M1x	a'an@zkj	// аанызқь
_8M1	a'an@zkji	// аанызқьи
_9M1x	Zwn'@zkj	// жәнызқь
_9M1	Zwn'@zkji	// жәнызқьи
_10M1x	Zw'an@zkj	// жәанызқь
_10M1	Zw'an@zkji	// жәанызқьи
_100M1x	Swn'@zkj	// шәнызқь
_100M1	Swn'@zkji	// шәнызқьи
_0M1x	n'@zkj	// нызқь
_0M1	n'@zkji	// нызқьи

