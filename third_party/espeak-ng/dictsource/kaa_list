// This file is UTF8 encoded
// Spelling to phoneme rules for Karakalpak

// Letters
// The vowels are named by their sound. The consonants are named as in the
// alphabets of the region (be, de, ef, ka, el ...).
a 'A
á '&
b b'e
d d'e
e 'e
f 'ef
g g'e
ǵ G'A
h h'A
x x'A
ı '@
í '@    // the capital of ı is Í, which eSpeak NG makes í
i 'I
j Z'e
k k'A
q q'A
l 'el
m 'em
n 'en
ń 'eN
o 'o
ó '8
p p'e
r 'e*
s 'es
t t'e
u 'U
ú 'u#
v v'e
w w'e
y j'e
z z'e
c ts'e
// ş and ç of the Latin alphabet of 1994, written for sh and ch: named sha, che
ş S'A
ç tS'e

_cap b'As    // bas (hárip)

// names of punctuation marks (the terms of Karakalpak grammar: tınıs belgileri)
_. n'oqAt              // noqat
_, 'u#tI*              // útir
_; noq'AtL@||'u#tI*    // noqatlı útir
_: q'os||n'oqAt        // qos noqat
_? s'o*Aw||beLg'IsI    // soraw belgisi
_! 'u#ndew||beLg'IsI   // úndew belgisi
_… k'8p||n'oqAt        // kóp noqat
_" t@*n'AqSA           // tırnaqsha
_« t@*n'AqSA
_» t@*n'AqSA
_„ t@*n'AqSA
_“ t@*n'AqSA
_” t@*n'AqSA
_( q'Aw@s              // qawıs
_) q'Aw@s
_- d'efIs              // defis
_– s@z@qS'A            // sızıqsha
_— s@z@qS'A
_' Ap'ost*of           // apostrof
_ʻ Ap'ost*of

// Numbers
_0 n'Yl
_1 b'Ir
_2 j'ekI
_3 u#S
_4 t8rt
_5 b'es
_6 'Alt@
_7 Z'etI
_8 s'egIz
_9 t'oG@z
_1X 'on
_2X Z@g@rm'A
_3X 'ot@z
_4X q'@r@q
_5X 'eliw
_6X 'ALp@s
_7X Zetp'Is
_8X seks'en
_9X toqs'An
_0C Z'u#z
_0M1 m'@N    // bir mıń: "bir" is said before a thousand, not before a hundred
_0M2 m@jLL@j'on
_1M2 m@jLL@j'on
_0M3 m@jLL@j'Ard
_1M3 m@jLL@j'Ard

