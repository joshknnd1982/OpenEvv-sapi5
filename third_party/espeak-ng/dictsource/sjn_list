// numbers
// Only 1-12 are attested. Zero is not, so "lost" (empty) is used. The translator
// has no number option: numbers are spoken as individual digits, except 10-12.
_0	l'Ost	// lost
_1	m'In	// min
_2	t'a::d	// tâd
