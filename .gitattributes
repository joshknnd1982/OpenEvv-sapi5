* text=auto

# Never touched by line-ending conversion.
*.dll binary
*.exe binary
*.wav binary
*.zip binary
*.ico binary
*.bin binary

# Windows scripts keep CRLF, shell scripts LF, whatever the checkout's settings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
installer/generated/*.inc text eol=crlf
*.sh text eol=lf

# eSpeak NG's compiled data is used byte for byte, whatever looks like text in it.
dist/espeak-ng-data/** -text

# The community pronunciation dictionary is cp1252 text with its own line ends; committed byte for byte.
dictionaries/community/*.dic -text

# eSpeak NG's source (third_party/README.md) is kept byte for byte as its tag has it, on every checkout.
third_party/espeak-ng/** -text
